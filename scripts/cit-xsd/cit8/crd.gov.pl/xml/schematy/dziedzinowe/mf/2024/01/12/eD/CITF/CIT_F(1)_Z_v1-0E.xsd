<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czf="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2024/01/12/eD/CITF/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2024/01/12/eD/CITF/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="../../../../../2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8. Wypełnia fundacja rodzinna, do której ma zastosowanie art. 24r ustawy.-->
	<!-- -->
	<!--Ilekroć jest mowa o ustawie o fundacji rodzinnej, oznacza to ustawę z dnia 26 stycznia 2023 r. o fundacji rodzinnej (Dz. U. poz. 326, z późn. zm.).-->
	<xsd:complexType name="TNaglowek_CIT_F">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czf:TKodFormularza_CIT_F">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/F (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czf:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czf:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2023-05-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_F">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/F"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_F">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI DOCHODU (PRZYCHODU) Z DZIAŁALNOŚCI GOSPODARCZEJ FUNDACJI RODZINNEJ WYKRACZAJĄCEJ POZA ZAKRES OKREŚLONY W ART. 5 USTAWY O FUNDACJI RODZINNEJ ORAZ PODATKU 
DOCHODOWEGO OD OSÓB PRAWNYCH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czf:TNaglowek_CIT_F"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Ustalenie podstawy opodatkowania / straty, obliczenie wysokości podatku, o którym mowa w art. 19 w zw. z art. 24r ustawy</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<!--B. USTALENIE PODSTAWY OPODATKOWANIA / STRATY-->
							<!-- -->
							<!--B.1. PRZYCHODY-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.1. Przychody</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_7" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych na terytorium RP - przychody z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_8" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych na terytorium RP - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP - z wyłączeniem przychodów, z których dochód podlega zwolnieniu z opodatkowania na podstawie art. 17 ust. 1 pkt 3 ustawy - przychody z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP - z wyłączeniem przychodów, z których dochód podlega zwolnieniu z opodatkowania na podstawie art. 17 ust. 1 pkt 3 ustawy - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP, z których dochód podlega zwolnieniu z opodatkowania na podstawie art. 17 ust. 1 pkt 3 ustawy - przychody z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody ze źródeł przychodów położonych poza terytorium RP, z których dochód podlega zwolnieniu z opodatkowania na podstawie art. 17 ust. 1 pkt 3 ustawy - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Razem przychody podlegające opodatkowaniu - z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 13 należy wpisać sumę kwot z poz. 7 i 9.-->
								</xsd:element>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Razem przychody podlegające opodatkowaniu - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 14 należy wpisać sumę kwot z poz. 8 i 10.-->
								</xsd:element>
							</xsd:sequence>
							<!--B.2. KOSZTY UZYSKANIA PRZYCHODÓW-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.2. Koszty uzyskania przychodów</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_15" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 7 lub 8 - koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 7 lub 8 - koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_17" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 9 lub 10 - koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 9 lub 10 - koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_19" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 11 lub 12 - koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów wymienionych odpowiednio w poz. 11 lub 12 - koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty finansowania dłużnego wyłączone w poprzednich pięciu latach podatkowych z kosztów uzyskania przychodów, podlegające na podstawie art. 15c ustawy zaliczeniu do kosztów uzyskania przychodów w roku podatkowym - koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty finansowania dłużnego wyłączone w poprzednich pięciu latach podatkowych z kosztów uzyskania przychodów, podlegające na podstawie art. 15c ustawy zaliczeniu do kosztów uzyskania przychodów w roku podatkowym - koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Razem koszty uzyskania przychodów podlegających opodatkowaniu - koszty uzyskania przychodów z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 23 należy wpisać sumę kwot z poz. 15, 17 i 21.-->
								</xsd:element>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Razem koszty uzyskania przychodów podlegających opodatkowaniu - koszty uzyskania przychodów z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 24 należy wpisać sumę kwot z poz. 16, 18 i 22.-->
								</xsd:element>
							</xsd:sequence>
							<!--B.3. DOCHÓD / STRATA-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>B.3. Dochód / strata</xsd:documentation>
								</xsd:annotation>
								<xsd:choice minOccurs="0">
									<xsd:element name="P_25" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Dochód - z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
										<!--Od kwoty odpowiednio z poz. 13 lub 14 należy odjąć kwotę odpowiednio z poz. 23 lub 24. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									</xsd:element>
									<xsd:element name="P_27" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Strata - z zysków kapitałowych</xsd:documentation>
										</xsd:annotation>
										<!--Od kwoty odpowiednio z poz. 23 lub 24 należy odjąć kwotę odpowiednio z poz. 13 lub 14. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									</xsd:element>
								</xsd:choice>
								<xsd:choice minOccurs="0">
									<xsd:element name="P_26" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Dochód - z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
										<!--Od kwoty odpowiednio z poz. 13 lub 14 należy odjąć kwotę odpowiednio z poz. 23 lub 24. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									</xsd:element>
									<xsd:element name="P_28" type="etd:TKwota2Nieujemna" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Strata - z innych źródeł przychodów</xsd:documentation>
										</xsd:annotation>
										<!--Od kwoty odpowiednio z poz. 23 lub 24 należy odjąć kwotę odpowiednio z poz. 13 lub 14. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									</xsd:element>
								</xsd:choice>
							</xsd:sequence>
							<!--B.4. PODSTAWA OPODATKOWANIA-->
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>B.4. Podstawa opodatkowania</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_29" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podstawa opodatkowania przed odliczeniami i doliczeniami - z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_30" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podstawa opodatkowania przed odliczeniami i doliczeniami - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_31" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Doliczenia do podstawy opodatkowania - z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Doliczenia do podstawy opodatkowania - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_33" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odliczenia od podstawy opodatkowania - z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_34" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odliczenia od podstawy opodatkowania - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_35" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podstawa opodatkowania po uwzględnieniu doliczeń i odliczeń - z zysków kapitałowych</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 35 do kwoty z poz. 29 należy dodać kwotę z poz. 31, a następnie odjąć kwotę z poz. 33. Jeżeli różnica jest liczbą ujemną, należy wpisać 0. Należy wpisać kwoty po zaokrągleniu do pełnych złotych.-->
								</xsd:element>
								<xsd:element name="P_36" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podstawa opodatkowania po uwzględnieniu doliczeń i odliczeń - przychody z innych źródeł przychodów</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 36 do kwoty z poz. 30 należy dodać kwotę z poz. 32, a następnie odjąć kwotę z poz. 34. Jeżeli różnica jest liczbą ujemną, należy wpisać 0. Należy wpisać kwoty po zaokrągleniu do pełnych złotych.-->
								</xsd:element>
							</xsd:sequence>
							<!--C. OBLICZENIE WYSOKOŚCI PODATKU, O KTÓRYM MOWA W ART. 19 W ZW. Z ART. 24R USTAWY-->
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>C. Obliczenie wysokości podatku, o którym mowa w art. 19 w zw. z art. 24r ustawy</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_37" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek należny według stawki 25%</xsd:documentation>
									</xsd:annotation>
									<!--Podatek obliczony od podstawy z poz. odpowiednio 35 lub 36. Należy wpisać kwotę po zaokrągleniu do pełnych złotych.-->
								</xsd:element>
								<xsd:element name="P_38" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Doliczenia do podatku</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_39" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odliczenia od podatku</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_40" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek należny po uwzględnieniu doliczeń i odliczeń</xsd:documentation>
									</xsd:annotation>
									<!--Do kwoty z poz. 37 należy dodać kwotę z poz. 38, a następnie odjąć kwotę z poz. 39. Jeżeli różnica jest liczbą ujemną, należy wpisać 0. Należy wpisać kwotę po zaokrągleniu do pełnych złotych.
Kwotę z poz. 40 należy przenieść do odpowiedniej pozycji zeznania CIT-8.-->
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>