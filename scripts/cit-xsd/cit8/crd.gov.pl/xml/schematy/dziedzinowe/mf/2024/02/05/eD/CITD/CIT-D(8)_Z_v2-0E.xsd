<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:czd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2024/02/05/eD/CITD/" xmlns:kk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2024/02/05/eD/CITD/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="../../../../../2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" schemaLocation="../../../../../2023/09/06/eD/KodyKrajow/KodyKrajow_v13-0E.xsd"/>
	<!--Ilekroć w informacji jest mowa o urzędzie skarbowym, w tym urzędzie skarbowym, do którego adresowana jest informacja - oznacza to urząd skarbowy, przy pomocy którego właściwy dla podatnika naczelnik urzędu skarbowego wykonuje swoje zadania.-->
	<xsd:complexType name="TNaglowek_CIT-D">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czd:TKodFormularza_CD">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT-D (8)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="8"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czd:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czd:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2022-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CD">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-D"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT-D">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA PODATNIKA PODATKU DOCHODOWEGO OD OSÓB PRAWNYCH O OTRZYMANYCH/PRZEKAZANYCH DAROWIZNACH</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czd:TNaglowek_CIT-D"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Informacja o darowiznach, informacje o celach i publikacji, informacja podatnika (darczyńcy) korzystającego z odliczenia o przekazanych darowiznach</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_6" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Nr formularza</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_8">
								<xsd:annotation>
									<xsd:documentation>Informacja stanowi załącznik do zeznania</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:byte">
										<xsd:enumeration value="2"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:element name="P_10">
								<xsd:annotation>
									<xsd:documentation>Rodzaj podatnika</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:byte">
										<xsd:enumeration value="1">
											<xsd:annotation>
												<xsd:documentation>wyłącznie otrzymujący darowiznę</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
										<xsd:enumeration value="2">
											<xsd:annotation>
												<xsd:documentation>wyłącznie przekazujący darowiznę i korzystający z odliczenia</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
										<xsd:enumeration value="3">
											<xsd:annotation>
												<xsd:documentation>otrzymujący oraz przekazujący darowiznę i korzystający z odliczenia</xsd:documentation>
											</xsd:annotation>
										</xsd:enumeration>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<!--C. INFORMACJA O DAROWIZNACH-->
							<!-- -->
							<!--Część C.1 i kolejne dotyczące danych darczyńcy należy wypełniać tylko wówczas, gdy jednorazowa kwota darowizny przekroczy 15 000 zł lub jeżeli suma wszystkich darowizn otrzymanych w danym roku podatkowym od jednego darczyńcy przekroczy 35 000 zł.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja o darowiznach</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota ogółem otrzymanych darowizn</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<!--C.1. DANE DARCZYŃCY-->
								<!-- -->
								<!--Należy wpisać kwotę darowizny oraz dane osoby prawnej, od której podatnik otrzymał darowiznę.-->
								<xsd:element name="P_C" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane darczyńcy</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_C22" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwota darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<!--C.1.1. DANE IDENTYFIKACYJNE-->
											<xsd:element name="P_C23" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Nazwa pełna</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<!--C.1.2. ADRES SIEDZIBY-->
											<xsd:sequence>
												<xsd:annotation>
													<xsd:documentation>Adres siedziby</xsd:documentation>
												</xsd:annotation>
												<xsd:element name="P_C24A" type="kk:TKodKraju">
													<xsd:annotation>
														<xsd:documentation>Kraj</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C25" type="etd:TJednAdmin" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Województwo</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C26" type="etd:TJednAdmin" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Powiat</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C27" type="etd:TJednAdmin" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Gmina</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C28" type="etd:TUlica" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Ulica</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C29" type="etd:TNrBudynku" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Nr domu</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C30" type="etd:TNrLokalu" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Nr lokalu</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C31" type="etd:TMiejscowosc">
													<xsd:annotation>
														<xsd:documentation>Miejscowość</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_C32" type="etd:TKodPocztowy" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Kod pocztowy</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
							<!--D. NFORMACJE O CELACH I PUBLIKACJI-->
							<!-- -->
							<!--D.1. CELE, NA KTÓRE PRZEZNACZONE ZOSTAŁY OTRZYMANE DAROWIZNY-->
							<!-- -->
							<!--Cele zgodnie ze sferą działalności pożytku publicznego, o której mowa w art. 4 ustawy z dnia 24 kwietnia 2003 r. o działalności pożytku publicznego i o wolontariacie (Dz. U. z 2023 r. poz. 571, z późn. zm.), i cele kultu religijnego, o których mowa w art. 18 ust. 1 pkt 7 ustawy, oraz cele wynikające z odrębnych ustaw. Należy zaznaczyć właściwe kwadraty.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Cele, na które przeznaczone zostały otrzymane darowizny</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_33" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Działalność charytatywna</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_34" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Pomoc ofiarom katastrof, klęsk żywiołowych, konfliktów zbrojnych i wojen w kraju i za granicą</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_35" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Pomoc społeczna, w tym pomoc rodzinom i osobom w trudnej sytuacji życiowej oraz wyrównywanie szans tych rodzin i osób</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_36" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Krajoznawstwo oraz wypoczynek dzieci i młodzieży</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_37" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Nauka, edukacja, oświata i wychowanie</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_38" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Działania na rzecz osób niepełnosprawnych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_39" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kultura, sztuka, ochrona dóbr kultury i tradycji</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_40" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ekologia i ochrona zwierząt oraz ochrona dziedzictwa przyrodniczego</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_41" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ochrona i promocja zdrowia</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_42" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Działalność wspomagająca rozwój gospodarczy, w tym rozwój przedsiębiorczości</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_43" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Upowszechnienie kultury fizycznej i sportu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_44" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Ratownictwo i ochrona ludności</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_45" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Cele kultu religijnego</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_46" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Działalność charytatywno-opiekuńcza</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_47" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Pozostałe cele</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--D.2. INFORMACJA O PUBLIKACJI DANYCH-->
							<xsd:element name="P_48" type="etd:TWybor1" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Podatnik udostępnił do publicznej wiadomości informacje na podstawie art. 18 ust. 1e pkt 2 ustawy</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<!--E. INFORMACJA PODATNIKA (DARCZYŃCY) KORZYSTAJĄCEGO Z ODLICZENIA O PRZEKAZANYCH DAROWIZNACH-->
							<!-- -->
							<!--INFORMACJA O KWOCIE DAROWIZN OGÓŁEM-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Informacja podatnika (darczyńcy) korzystającego z odliczenia o przekazanych darowiznach</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_49" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota przekazanej darowizny ogółem</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_50" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Kwota odliczonej darowizny ogółem</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<!--E.1. INFORMACJA O OBDAROWANYM-->
								<xsd:element name="P_E" maxOccurs="unbounded">
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_E51" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwota przekazanej darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E52" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Kwota odliczonej darowizny</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<!--E.1.1. DANE IDENTYFIKACYJNE OBDAROWANEGO-->
											<!-- -->
											<!--Należy wpisać dane podmiotu, któremu przekazano darowiznę wykazaną w poz. 51.-->
											<xsd:sequence>
												<xsd:element name="P_E53" type="etd:TNrIdentyfikacjiPodatkowej">
													<xsd:annotation>
														<xsd:documentation>Identyfikator podatkowy NIP lub numer uzyskany w innym niż Rzeczpospolita Polska państwie członkowskim Unii Europejskiej lub innym państwie należącym do Europejskiego Obszaru Gospodarczego, w którym obdarowany ma siedzibę, służący dla celów podatkowych identyfikacji</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E54" type="kk:TKodKraju">
													<xsd:annotation>
														<xsd:documentation>Kod kraju numeru identyfikacji podatkowej</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E55" type="etd:TZnakowy">
													<xsd:annotation>
														<xsd:documentation>Nazwa pełna</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
											<!--E.1.2. ADRES SIEDZIBY-->
											<xsd:sequence>
												<xsd:element name="P_E56A" type="kk:TKodKraju">
													<xsd:annotation>
														<xsd:documentation>Kraj</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E57" type="etd:TJednAdmin" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Województwo</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E58" type="etd:TJednAdmin" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Powiat</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E59" type="etd:TJednAdmin" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Gmina</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E60" type="etd:TUlica" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Ulica</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E61" type="etd:TNrBudynku" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Nr domu</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E62" type="etd:TNrLokalu" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Nr lokalu</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E63" type="etd:TMiejscowosc">
													<xsd:annotation>
														<xsd:documentation>Miejscowość</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_E64" type="etd:TKodPocztowy" minOccurs="0">
													<xsd:annotation>
														<xsd:documentation>Kod pocztowy</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>