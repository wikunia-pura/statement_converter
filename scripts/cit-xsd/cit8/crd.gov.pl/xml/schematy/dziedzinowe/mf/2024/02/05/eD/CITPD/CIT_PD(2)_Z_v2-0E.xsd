<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:czpd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2024/02/05/eD/CITPD/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:kk="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2024/02/05/eD/CITPD/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2023/09/06/eD/KodyKrajow/" schemaLocation="../../../../../2023/09/06/eD/KodyKrajow/KodyKrajow_v13-0E.xsd"/>
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="../../../../../2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Wypełnia podatnik, który w roku podatkowym poniósł na rzecz podmiotu powiązanego i zaliczył do kosztów uzyskania przychodu koszty, o których mowa w art. 24aa ust. 2 i 3 ustawy, zwane dalej „przerzuconymi dochodami”.-->
	<!-- -->
	<!--Wypełnia podatnik, jeżeli suma kosztów, które stanowią przerzucone dochody wymienione w art. 24aa ust. 3 ustawy i zostały zaliczone w roku podatkowym do kosztów uzyskania przychodu, stanowi co najmniej 3% sumy kosztów uzyskania przychodu podatnika za ten rok oraz w przypadku spełnienia pozostałych warunków zawartych w art. 24aa ust. 2 ustawy. W przypadku PGK badając próg 3% należy odnieść sumę kosztów wskazanych w art. 24aa ust. 3 ustawy, poniesionych przez spółki tworzące PGK na rzecz podmiotów powiązanych i zaliczonych w danym roku podatkowym do kosztów uzyskania przychodów tych spółek, do sumy kosztów uzyskania przychodów wszystkich spółek PGK za ten rok.-->
	<xsd:complexType name="TNaglowek_CIT_PD">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czpd:TKodFormularza_CIT_PD">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/PD (2)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="2-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czpd:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="czpd:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2022-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_PD">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/PD"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodKrajuWydania">
		<xsd:annotation>
			<xsd:documentation>Kod kraju wydania numeru identyfikacyjnego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="kk:TKodKraju">
			<xsd:pattern value="P[A-KM-Z]"/>
			<xsd:pattern value="[A-OQ-Z][A-Z]"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TRodzajIdentyfikacji">
		<xsd:annotation>
			<xsd:documentation>Określa rodzaj identyfikacji: 1 - numer identyfikacyjny TIN, 2 - identyfikator ubezpieczeniowy, 8 - inny rodzaj identyfikacji podatkowej</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:byte">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>numer identyfikacyjny TIN</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>identyfikator ubezpieczeniowy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="8">
				<xsd:annotation>
					<xsd:documentation>inny rodzaj identyfikacji podatkowej</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TRodzajPodmiotu">
		<xsd:annotation>
			<xsd:documentation>Określa rodzaj podmiotu powiązanego</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:byte">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation>podmiotem, który spełnia warunki, o których mowa w art. 24aa ust. 2 pkt 1-3 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation>spółką niebędącą osobą prawną mającą siedzibę lub zarząd na terytorium Rzeczypospolitej Polskiej, o której mowa w art. 24aa ust. 14 pkt 1 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation>podmiotem niemającym siedziby lub zarządu na terytorium Rzeczypospolitej Polskiej, o którym mowa w art. 24aa ust. 14 pkt 2 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation>podmiotem, który spełnia warunki, o których mowa w art. 24aa ust. 15 ustawy</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_PD">
		<xsd:annotation>
			<xsd:documentation>INFORMACJA O WYSOKOŚCI PRZERZUCONYCH DOCHODÓW I NALEŻNEGO PODATKU OD PRZERZUCONYCH DOCHODÓW</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="czpd:TNaglowek_CIT_PD"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Podstawa opodatkowania, obliczenie podatku, dane dodatkowe - informacje o podmiotach powiązanych</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<!--B. PODSTAWA OPODATKOWANIA-->
							<!-- -->
							<!--Należy wykazać koszty stanowiące przerzucone dochody.-->
							<!-- -->
							<!--Uwzględnia się również koszty stanowiące w roku podatkowym odpisy amortyzacyjne lub odpisy umorzeniowe od wartości początkowej środka trwałego lub wartości niematerialnej lub prawnej oraz koszty przypisane zgodnie z art. 5 ustawy. W przypadku PGK należy wykazać sumę przerzuconych dochodów spółek tworzących PGK.-->
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Podstawa opodatkowania</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_8" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Usługi doradcze, badania rynku, usługi reklamowe, zarządzania i kontroli, przetwarzania danych, ubezpieczeń, gwarancji i poręczeń oraz usługi o podobnym charakterze</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_9" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Wszelkiego rodzaju opłaty i należności za korzystanie lub prawo do korzystania z praw lub wartości, o których mowa w art. 16b ust. 1 pkt 4-7 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_10" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przeniesienia ryzyka niewypłacalności dłużnika z tytułu pożyczek, innych niż udzielonych przez banki i spółdzielcze kasy oszczędnościowo-kredytowe, w tym w ramach zobowiązań wynikających z pochodnych instrumentów finansowych oraz świadczeń o podobnym charakterze</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_11" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty finansowania dłużnego związane z uzyskaniem środków finansowych i korzystaniem z tych środków, w szczególności odsetki, opłaty, prowizje, premie, część odsetkowa raty leasingowej, kary i opłaty za opóźnienie w zapłacie zobowiązań oraz koszty zabezpieczenia zobowiązań, w tym koszty pochodnych instrumentów finansowych</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_12" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Opłaty i wynagrodzenia za przeniesienie funkcji, aktywów lub ryzyk</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_13" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podstawa opodatkowania (po zaokrągleniu do pełnych złotych)</xsd:documentation>
									</xsd:annotation>
									<!--W poz. 13 należy wpisać sumę kwot z poz. 8-12.-->
								</xsd:element>
							</xsd:sequence>
							<!--C. OBLICZENIE PODATKU-->
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Obliczenie podatku</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_14" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek według stawki 19% - art. 24aa ust. 1 ustawy, obliczony od podstawy z poz. 13</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_15" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Odliczenie zryczałtowanego podatku dochodowego, o którym mowa w art. 21 ustawy, pobranego od wypłat z tytułu kosztów uwzględnionych w podstawie opodatkowania, zgodnie z art. 24aa ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_16" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek po odliczeniu</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 14 należy odjąć kwotę z poz. 15.-->
								</xsd:element>
								<xsd:element name="P_17" type="etd:TKwotaCNieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Doliczenie zmniejszenia pobranego zryczałtowanego podatku dochodowego zgodnie z art. 24aa ust. 8 ustawy</xsd:documentation>
									</xsd:annotation>
									<!--W przypadku braku spełnienia przesłanek do obliczenia podatku z tytułu przerzuconych dochodów za dany rok przez podatnika przy jednoczesnej konieczności dokonania doliczenia, o którym mowa w art. 24aa ust. 8 ustawy, należy wypełnić jedynie poz. 1-7 i 17. Doliczenie wykazane w poz. 17 stanowi wówczas podatek należny od przerzuconych dochodów, który należy wykazać w odpowiedniej pozycji zeznania CIT-8 lub CIT-8AB.-->
								</xsd:element>
								<xsd:element name="P_18" type="etd:TKwotaCNieujemna">
									<xsd:annotation>
										<xsd:documentation>Podatek do zapłaty (po zaokrągleniu do pełnych złotych)</xsd:documentation>
									</xsd:annotation>
									<!--Do kwoty z poz. 16 należy dodać kwotę z poz. 17.
										Kwotę z poz. 18 należy wpisać do odpowiedniej pozycji zeznania CIT-8 lub CIT-8AB.-->
								</xsd:element>
							</xsd:sequence>
							<!--D. DANE DODATKOWE - INFORMACJE O PODMIOTACH POWIĄZANYCH-->
							<!-- -->
							<!--Podatnik wykazuje dane podmiotów powiązanych z podatnikiem, o których mowa w art. 24aa ust. 2, 14 lub 15 ustawy.-->
							<!-- -->
							<!--D.1. DANE PODMIOTU POWIĄZANEGO-->
							<!-- -->
							<!--D.1.1. DANE IDENTYFIKACYJNE-->
							<xsd:element name="P_D" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Dane dodatkowe - informacje o podmiotach powiązanych</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>Dane podmiotu powiązanego</xsd:documentation>
										</xsd:annotation>
										<xsd:sequence>
											<xsd:annotation>
												<xsd:documentation>Dane identyfikacyjne</xsd:documentation>
											</xsd:annotation>
											<xsd:element name="P_D19" type="czpd:TRodzajPodmiotu">
												<xsd:annotation>
													<xsd:documentation>Podmiot powiązany jest: 1 - podmiotem, który spełnia warunki, o których mowa w art. 24aa ust. 2 pkt 1-3 ustawy, 2 - spółką niebędącą osobą prawną mającą siedzibę lub zarząd na terytorium Rzeczypospolitej Polskiej, o której mowa w art. 24aa ust. 14 pkt 1 ustawy, 3 - podmiotem niemającym siedziby lub zarządu na terytorium Rzeczypospolitej Polskiej, o którym mowa w art. 24aa ust. 14 pkt 2 ustawy, 4 - podmiotem, który spełnia warunki, o których mowa w art. 24aa ust. 15 ustawy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D20" type="etd:TNrNIP" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Identyfikator podatkowy NIP</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:sequence minOccurs="0">
												<xsd:element name="P_D21" type="etd:TNrDokumentuStwierdzajacegoTozsamosc">
													<xsd:annotation>
														<xsd:documentation>Zagraniczny numer identyfikacyjny</xsd:documentation>
													</xsd:annotation>
													<!--W poz. 21 należy podać numer służący identyfikacji dla celów podatkowych uzyskany w państwie, w którym podmiot powiązany ma siedzibę lub zarząd.-->
												</xsd:element>
												<xsd:element name="P_D22" type="czpd:TRodzajIdentyfikacji">
													<xsd:annotation>
														<xsd:documentation>Rodzaj zagranicznego numeru identyfikacyjnego</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
												<xsd:element name="P_D23" type="czpd:TKodKrajuWydania">
													<xsd:annotation>
														<xsd:documentation>Kod kraju wydania zagranicznego numeru identyfikacyjnego</xsd:documentation>
													</xsd:annotation>
												</xsd:element>
											</xsd:sequence>
											<xsd:element name="P_D24">
												<xsd:annotation>
													<xsd:documentation>Nazwa pełna podmiotu</xsd:documentation>
												</xsd:annotation>
												<xsd:simpleType>
													<xsd:restriction base="xsd:token">
														<xsd:minLength value="1"/>
														<xsd:maxLength value="240"/>
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:element>
										</xsd:sequence>
										<!--D.1.2. ADRES SIEDZIBY PODMIOTU POWIĄZANEGO-->
										<!-- -->
										<!--W przypadku podmiotu niemającego siedziby lub zarządu na terytorium Polski nie wypełnia się pola 26 (województwo), 27 (powiat) i 28 (gmina).-->
										<xsd:sequence>
											<xsd:annotation>
												<xsd:documentation>Adres siedziby podmiotu powiązanego</xsd:documentation>
											</xsd:annotation>
											<xsd:element name="P_D25A" type="kk:TKodKraju">
												<xsd:annotation>
													<xsd:documentation>Kraj</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D26" type="etd:TJednAdmin" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Województwo</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D27" type="etd:TJednAdmin" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Powiat</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D28" type="etd:TJednAdmin" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Gmina</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D29" type="etd:TUlica" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Nazwa ulicy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D30" type="etd:TNrBudynku" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Numer budynku</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D31" type="etd:TNrLokalu" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Numer lokalu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D32" type="etd:TMiejscowosc">
												<xsd:annotation>
													<xsd:documentation>Nazwa miejscowości</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D33" type="etd:TKodPocztowy" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Kod pocztowy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>