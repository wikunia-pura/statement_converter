								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_13" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody (przychody) wolne od podatku na podstawie art. 17 ust. 1 pkt 4 ustawy w części przeznaczonej na cele statutowe - Dochody (przychody) z zysków kapitałowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_14" type="etd:TKwota2Nieujemna" minOccurs="0">
