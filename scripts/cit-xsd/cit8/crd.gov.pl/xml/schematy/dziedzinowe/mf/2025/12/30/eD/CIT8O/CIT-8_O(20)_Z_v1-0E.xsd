<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:cz8o="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/12/30/eD/CIT8O/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/12/30/eD/CIT8O/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="../../../../../2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznania CIT-8.-->
	<xsd:complexType name="TNaglowek_CIT-8_O">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8o:TKodFormularza_CIT-8_O">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT8/O (20)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="20"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8o:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8o:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2025-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT-8_O">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT-8/O"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT-8_O">
		<xsd:annotation>
			<xsd:documentation>Informacja o odliczeniach od dochodu i od podatku oraz o dochodach (przychodach) wolnych od podatku</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="cz8o:TNaglowek_CIT-8_O"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dochody (przychody) wolne od podatku i odliczenia od dochodu, odliczenia z tytułu wydatków inwestycyjnych, odliczenia od podstawy opodatkowania, zwolnienia, zaniechania, obniżki i odliczenia od podatku, dane informacyjne</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<!--B. Dochody (przychody) wolne od podatku i odliczenia od dochodu-->
							<!-- -->
							<!--B.1. Dochody (przychody) wolne od podatku-->
							<xsd:element name="P_7" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody (przychody) wolne od podatku, przeznaczone na cele statutowe lub inne cele wymienione w art. 17 ust. 1 pkt 4d, 4g-4u, 5a, 26, 37, 42, 43, 45 i 46 ustawy - Dochody (przychody) z zysków kapitałowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_8" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody (przychody) wolne od podatku, przeznaczone na cele statutowe lub inne cele wymienione w art. 17 ust. 1 pkt 4d, 4g-4u, 5a, 26, 37, 42, 43, 45 i 46 ustawy - Dochody (przychody) z innych źródeł przychodów</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_9" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody z tytułu sprzedaży całości, części nieruchomości lub udziału w nieruchomości wchodzącej w skład gospodarstwa rolnego - wolne od podatku na podstawie art. 17 ust. 1 pkt 1 ustawy - Dochody (przychody) z zysków kapitałowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_10" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody z tytułu sprzedaży całości, części nieruchomości lub udziału w nieruchomości wchodzącej w skład gospodarstwa rolnego - wolne od podatku na podstawie art. 17 ust. 1 pkt 1 ustawy - Dochody (przychody) z innych źródeł przychodów</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_11" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dochody wolne od podatku na podstawie art. 17 ust. 1 pkt 3 ustawy osiągane poza RP, jeżeli umowa międzynarodowa tak stanowi - Dochody (przychody) z zysków kapitałowych</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="P_12" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
