							<xsd:element name="P_23" type="etd:TKwota2Nieujemna" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Dotacje, subwencje, dopłaty i inne nieodpłatne świadczenia - wolne od podatku na podstawie art. 17 ust. 1 pkt 21 ustawy - Dochody (przychody) z zysków kapitałowych</xsd:documentation>
