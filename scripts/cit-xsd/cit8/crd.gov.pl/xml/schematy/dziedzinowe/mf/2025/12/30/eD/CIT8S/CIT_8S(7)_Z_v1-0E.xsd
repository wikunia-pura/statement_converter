<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:cz8s="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/12/30/eD/CIT8S/" xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/12/30/eD/CIT8S/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="../../../../../2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Formularz jest przeznaczony dla podatników podatku dochodowego od osób prawnych będących beneficjentami pomocy w rozumieniu przepisów o pomocy publicznej.-->
	<xsd:complexType name="TNaglowek_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TKodFormularza_CIT_8S">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CIT/8S (7)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="7"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="cz8s:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2025-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodFormularza_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/8S"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_8S">
		<xsd:annotation>
			<xsd:documentation>Informacja o wysokości dochodu osiągniętego z działalności gospodarczej prowadzonej na podstawie zezwolenia na terenie specjalnej strefy ekonomicznej lub na podstawie decyzji o wsparciu</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="cz8s:TNaglowek_CIT_8S"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane dotyczące zezwoleń lub decyzji o wsparciu posiadanych przez podatnika, ustalenie wielkości dochodu podlegającego zwolnieniu z podatku z działalności gospodarczej prowadzonej na podstawie zezwoleń na terenie specjalnej strefy ekonomicznej lub na podstawie decyzji o wsparciu, dane dotyczące rozliczenia pomocy publicznej, dane dotyczące cofniętych zezwoleń lub uchylonych decyzji o wsparciu, wielkość kosztów kwalifikowanych, rozliczanych w ramach ulgi B+R</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="P_B" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące zezwolenia lub decyzji o wsparciu</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<!--B. Dane dotyczące zezwoleń lub decyzji o wsparciu posiadanych przez podatnika-->
										<!-- -->
										<!--Należy wskazać wszystkie zezwolenia na prowadzenie działalności na terenie specjalnej strefy ekonomicznej lub decyzje o wsparciu, na podstawie których przedsiębiorca poniósł koszty kwalifikujące się do objęcia pomocą publiczną.-->
										<xsd:element name="P_B8" type="etd:TZnakowy">
											<xsd:annotation>
												<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B9" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data wydania zezwolenia lub decyzji o wsparciu</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B10" type="etd:TData">
											<xsd:annotation>
												<xsd:documentation>Data rozpoczęcia działalności</xsd:documentation>
											</xsd:annotation>
											<!--Przez datę rozpoczęcia działalności należy rozumieć rozpoczęcie robót budowlanych związanych z inwestycją lub pierwsze prawnie wiążące zobowiązanie do zamówień urządzeń lub inne zobowiązanie, które sprawia, że inwestycja staje się nieodwracalna, zależnie od tego, co nastąpi najpierw. Zakupu gruntów ani prac przygotowawczych, takich jak uzyskanie zezwoleń i przeprowadzenie studiów wykonalności, nie uznaje się za rozpoczęcie prac - art. 2 pkt 23 rozporządzenia 
Komisji (UE) nr 651/2014 z dnia 17 czerwca 2014 r. uznającego niektóre rodzaje pomocy za zgodne z rynkiem wewnętrznym w zastosowaniu art. 107 i art. 108 Traktatu. Koszty kwalifikowane to koszty, o których mowa w rozporządzeniu Rady Ministrów z dnia 27 grudnia 2022 r. w sprawie pomocy publicznej udzielanej niektórym przedsiębiorcom na realizację nowych inwestycji, zwanym dalej „rozporządzeniem Rady Ministrów z dnia 27 grudnia 2022 r.”, w zakresie działalności 
prowadzonej na podstawie decyzji o wsparciu, albo koszty kwalifikowane, o których mowa w rozporządzeniu Rady Ministrów z dnia 10 grudnia 2008 r. w sprawie pomocy publicznej udzielanej przedsiębiorcom działającym na podstawie zezwolenia na prowadzenie działalności gospodarczej na terenach specjalnych stref ekonomicznych, zwanym dalej „rozporządzeniem Rady Ministrów z dnia 10 grudnia 2008 r.”, w zakresie działalności prowadzonej na podstawie zezwolenia.-->
										</xsd:element>
										<!--B.1.1. Ustalenie dopuszczalnej wartości pomocy publicznej-->
										<!-- -->
										<!--(od dnia uzyskania zezwolenia lub decyzji o wsparciu do ostatniego dnia roku, którego dotyczy zeznanie). Należy wykazać dane dotyczące podatnika posiadającego zezwolenie lub decyzję o wsparciu.-->
										<!-- -->
										<!--Zdyskontowaną pomoc publiczną ustala się zgodnie z § 10 ust. 3 rozporządzenia Rady Ministrów z dnia 27 grudnia 2022 r. w przypadku przedsiębiorców prowadzących inwestycję na podstawie decyzji o wsparciu lub § 7 ust. 6 rozporządzenia Rady Ministrów z dnia 10 grudnia 2008 r. w przypadku przedsiębiorców prowadzących inwestycję na podstawie zezwolenia.-->
										<xsd:sequence>
											<!--Należy wykazać faktycznie poniesione koszty kwalifikujące się do objęcia pomocą publiczną przez przedsiębiorcę wskazanego w poz. 7, obejmujące koszty poniesione w okresie od daty wydania zezwolenia lub decyzji o wsparciu wskazanej w poz. 9, do końca roku podatkowego, za który jest składane zeznanie.-->
											<xsd:element name="P_B11" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną narastająco - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B12" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Koszty kwalifikujące się do objęcia pomocą publiczną narastająco - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
										<!--Przez maksymalną wartość pomocy publicznej uważa się iloczyn maksymalnej intensywności pomocy określonej dla danego obszaru i faktycznie poniesionych kosztów inwestycji kwalifikujących się do objęcia pomocą.-->
											<xsd:element name="P_B13" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B14" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Maksymalna wartość pomocy publicznej - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!-- Należy wykazać faktycznie uzyskaną pomoc publiczną przez przedsiębiorcę wskazanego w poz. 7. Wartość pomocy nie obejmuje pomocy udzielonej na podstawie składanego zeznania.-->
											<xsd:element name="P_B15" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia lub decyzji o wsparciu z poz. 8 - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B16" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Pomoc udzielona na podstawie ustawy w ramach zezwolenia lub decyzji o wsparciu z poz. 8 - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:sequence>
											<!--Należy wykazać wsparcie uzyskane na inwestycję, na którą wydano zezwolenie lub decyzję o wsparciu, obejmujące okres od daty wydania zezwolenia lub decyzji o wsparciu, wskazanej w poz. 9, do końca roku podatkowego, za który jest składane zeznanie.-->
											<xsd:element name="P_B17" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - wartość</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_B18" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Inne wsparcie objęte pomocą - zdyskontowana wartość pomocy publicznej lub kosztów kwalifikowanych na dzień uzyskania zezwolenia lub decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<!--C. Ustalenie wielkości dochodu podlegającego zwolnieniu z podatku z działalności gospodarczej prowadzonej na podstawie zezwoleń na terenie specjalnej strefy ekonomicznej lub na podstawie decyzji o wsparciu-->
							<!-- -->
							<!--W poz. 19 i 20 podatnik wykazuje sumę przychodów i poniesionych kosztów uzyskania przychodów z działalności gospodarczej w roku podatkowym, za który jest składane zeznanie, określonej w zezwoleniach przedsiębiorcy. W poz. 24 i 25 podatnik wykazuje sumę przychodów i kosztów uzyskania przychodów w związku z realizacją nowej inwestycji określonej w decyzjach o wsparciu.-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Ustalenie wielkości dochodu podlegającego zwolnieniu z podatku z działalności gospodarczej prowadzonej na podstawie zezwoleń na terenie specjalnej strefy ekonomicznej lub na podstawie decyzji o wsparciu. Dane dotyczące zezwolenia (zezwoleń)</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_19" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_20" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_21" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Dochód z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 19 należy odjąć kwotę z poz. 20. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
								<xsd:element name="P_22" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kwalifikowany dochód z kwalifikowanego prawa własności intelektualnej</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_23" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata z działalności gospodarczej określonej w zezwoleniach</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 20 należy odjąć kwotę z poz. 19. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
							</xsd:sequence>
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Ustalenie wielkości dochodu podlegającego zwolnieniu z podatku z działalności gospodarczej prowadzonej na podstawie zezwoleń na terenie specjalnej strefy ekonomicznej lub na podstawie decyzji o wsparciu. Dane dotyczące decyzji o wsparciu</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_24" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Przychody z działalności gospodarczej osiągnięte z realizacji nowej inwestycji określonej w decyzjach o wsparciu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_25" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Koszty uzyskania przychodów z działalności gospodarczej poniesione z realizacji nowej inwestycji określonej w decyzjach o wsparciu</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_26" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Dochód z działalności gospodarczej osiągnięty z realizacji nowej inwestycji określonej w decyzjach o wsparciu</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 24 należy odjąć kwotę z poz. 25. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
								<xsd:element name="P_27" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Kwalifikowany dochód z kwalifikowanego prawa własności intelektualnej</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
								<xsd:element name="P_28" type="etd:TKwota2Nieujemna" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Strata z działalności gospodarczej poniesiona z realizacji nowej inwestycji określonej w decyzjach o wsparciu</xsd:documentation>
									</xsd:annotation>
									<!--Od kwoty z poz. 25 należy odjąć kwotę z poz. 24. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
								</xsd:element>
							</xsd:sequence>
							<!--D. Dane dotyczące rozliczenia pomocy publicznej-->
							<!-- -->
							<!--W poz. 29 i 30 należy wskazać zezwolenia / decyzje o wsparciu, w ramach których podatnik korzysta z pomocy publicznej w formie zwolnienia podatkowego w roku podatkowym, za który jest składane zeznanie.-->
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące rozliczenia pomocy publicznej</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_D" minOccurs="0" maxOccurs="unbounded">
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące zezwolenia / decyzji o wsparciu</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_D29" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer zezwolenia / decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D30" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data wydania zezwolenia / decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_D31" type="etd:TKwota2Nieujemna">
												<xsd:annotation>
													<xsd:documentation>Dochód podlegający zwolnieniu z podatku</xsd:documentation>
												</xsd:annotation>
												<!--Kwota wykazana w poz. 31 musi być równa sumie kwot z poz. 21 i 26.-->
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_32" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem dochód podlegający zwolnieniu z podatku</xsd:documentation>
									</xsd:annotation>
									<!--Kwota z poz. 32 musi być równa sumie kwot z poz. 21 i 26.-->
								</xsd:element>
							</xsd:sequence>
							<!--E. Dane dotyczące cofniętych zezwoleń lub uchylonych decyzji o wsparciu-->
							<!-- -->
							<!--Podatnik traci prawo do zwolnienia i jest obowiązany do zapłaty podatku należnego:
- od dochodu wynikającego z cofniętego zezwolenia albo z uchylonej decyzji o wsparciu, jeżeli podatnik korzystał z pomocy publicznej udzielonej w formie zwolnienia wyłącznie w ramach jednego zezwolenia albo w ramach jednej decyzji o wsparciu;
- od dochodu wynikającego z cofniętego zezwolenia albo z uchylonej decyzji o wsparciu, jeżeli podatnik korzystał z pomocy publicznej udzielonej w formie zwolnienia w ramach więcej niż jednego zezwolenia lub w ramach więcej niż jednej decyzji o wsparciu albo w ramach zezwolenia lub zezwoleń i decyzji  o wsparciu i jednocześnie podatnik ten prowadził ewidencję rachunkową, zgodnie z odrębnymi przepisami, w sposób zapewniający określenie dochodu z działalności określonej w cofniętym zezwoleniu lub w uchylonej decyzji o wsparciu oraz podatku niezapłaconego od tego dochodu;
- w wysokości stanowiącej maksymalną dopuszczalną pomoc publiczną określoną w cofniętym zezwoleniu lub w uchylonej decyzji o wsparciu, jeżeli podatnik korzystał ze zwolnienia w ramach więcej niż jednego zezwolenia lub w ramach więcej niż jednej decyzji o wsparciu albo w ramach zezwolenia lub zezwoleń  i decyzji o wsparciu.-->
							<!-- -->
							<!--E.1. Dane dotyczące cofniętego zezwolenia lub uchylonej decyzji o wsparciu-->
							<xsd:sequence>
								<xsd:annotation>
									<xsd:documentation>Dane dotyczące cofniętych zezwoleń lub uchylonych decyzji o wsparciu</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_E" minOccurs="0" maxOccurs="unbounded">
									<!--Należy wykazać dane, które zgodnie z art. 70 Ordynacji podatkowej nie uległy przedawnieniu.-->
									<xsd:annotation>
										<xsd:documentation>Dane dotyczące cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
									</xsd:annotation>
									<xsd:complexType>
										<xsd:sequence>
											<xsd:element name="P_E33" type="etd:TZnakowy">
												<xsd:annotation>
													<xsd:documentation>Numer cofniętego zezwolenia lub uchylonej decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E34" type="etd:TData">
												<xsd:annotation>
													<xsd:documentation>Data cofnięcia zezwolenia lub uchylenia decyzji o wsparciu</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E35" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Podatek należny od dochodu wynikającego z cofniętego zezwolenia albo od dochodu wynikającego z uchylonej decyzji o wsparciu, zgodnie z art. 17 ust. 6 pkt 1 lit. a ustawy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E36" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Podatek należny od dochodu wynikającego z cofniętego(-tych) zezwolenia(-ń) albo od dochodu wynikającego z uchylonej(-nych) decyzji o wsparciu, zgodnie z art. 17 ust. 6 pkt 1 lit. b ustawy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E37" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Podatek należny od dochodu wynikającego z cofniętego(-tych) zezwolenia(-ń) albo od dochodu wynikającego z uchylonej(-nych) decyzji o wsparciu, w wysokości stanowiącej maksymalną dopuszczalną pomoc publiczną, zgodnie z art. 17 ust. 6 pkt 2 ustawy</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
											<xsd:element name="P_E38" type="etd:TKwota2Nieujemna" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Podatek zapłacony w związku z cofnięciem zezwolenia lub uchyleniem decyzji o wsparciu, uiszczony w rozliczeniu zaliczki za wybrany okres wpłaty zaliczek</xsd:documentation>
												</xsd:annotation>
											</xsd:element>
										</xsd:sequence>
										<xsd:attribute name="typ" use="required" fixed="G"/>
									</xsd:complexType>
								</xsd:element>
								<xsd:element name="P_39" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Razem podatek podlegający doliczeniu do podatku zgodnie z art. 17 ust. 6 ustawy</xsd:documentation>
									</xsd:annotation>
									<!--Należy wskazać sumę kwot z poz. 35-37 pomniejszoną o kwoty z poz. 38. Jeżeli różnica jest liczbą ujemną, należy wpisać 0.-->
									<!-- -->
									<!--Należy wykazać dane dotyczące zobowiązania podatkowego, które zgodnie z art. 70 Ordynacji podatkowej nie uległo przedawnieniu. W przypadku gdy w roku podatkowym cofnięto więcej niż jedno zezwolenie lub uchylono więcej niż jedną decyzję o wsparciu podatnik składa kolejny załącznik CIT/8S. Jeżeli podatnik składa więcej niż jeden załącznik CIT/8S, w poz. 39 w ostatnim załączniku sumuje odpowiednie kwoty ze wszystkich załączników.-->
								</xsd:element>
							</xsd:sequence>
							<!--F. Wielkość kosztów kwalifikowanych, rozliczanych w ramach ulgi B+R-->
							<!-- -->
							<!--(wypełniają podatnicy, którzy posiadają zezwolenia na prowadzenie działalności na terenie specjalnych stref ekonomicznych lub decyzje o wsparciu)-->
							<xsd:sequence minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Wielkość kosztów kwalifikowanych, rozliczanych w ramach ulgi B+R</xsd:documentation>
								</xsd:annotation>
								<xsd:element name="P_40" type="etd:TKwota2Nieujemna">
									<xsd:annotation>
										<xsd:documentation>Koszty kwalifikowane odliczone od podstawy opodatkowania w ramach ulgi B+R</xsd:documentation>
									</xsd:annotation>
									<!--Podatnik uzyskujący przychody inne niż przychody z zysków kapitałowych może odliczyć od podstawy opodatkowania koszty uzyskania przychodów poniesione na działalność badawczo-rozwojową (koszty kwalifikowane), na podstawie art. 18d ustawy. Wypełnia podatnik, który prowadzi działalność jako przedsiębiorca wskazany w poz. 7 i ponosi koszty na działalność badawczo-rozwojową w ramach zezwolenia na prowadzenie działalności gospodarczej na terenie specjalnej strefy ekonomicznej lub w ramach decyzji o wsparciu.-->
								</xsd:element>
								<xsd:element name="P_41" type="etd:TZnakowy">
									<xsd:annotation>
										<xsd:documentation>Numer zezwolenia lub decyzji o wsparciu, w ramach których zostały poniesione koszty kwalifikowane</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>