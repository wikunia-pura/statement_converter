<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:etd="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:zcwt="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/12/30/eD/CITWOT/" targetNamespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2025/12/30/eD/CITWOT/" elementFormDefault="qualified" attributeFormDefault="unqualified" xml:lang="pl">
	<xsd:import namespace="http://crd.gov.pl/xml/schematy/dziedzinowe/mf/2022/09/13/eD/DefinicjeTypy/" schemaLocation="../../../../../2022/09/13/eD/DefinicjeTypy/StrukturyDanych_v12-0E.xsd"/>
	<!--Załącznik do zeznań: CIT-8 i CIT-8AB.-->
	<!-- -->
	<!--Wypełnia podatnik korzystający z odliczenia od podstawy opodatkowania na zasadach określonych w art. 18eg ustawy.-->
	<!-- -->
	<!--Rokiem podatkowym jest rok kalendarzowy lub w przypadku, o którym mowa w art. 8 ust. 1 ustawy, okres kolejnych dwunastu miesięcy, z uwzględnieniem art. 8 ust. 2, 2a, 3 i 6 ustawy.-->
	<xsd:complexType name="TNaglowek_CIT_WOT">
		<xsd:annotation>
			<xsd:documentation>Nagłówek deklaracji</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KodFormularza">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zcwt:TKodFormularza_CIT_WOT">
							<xsd:attribute name="kodSystemowy" type="xsd:string" use="required" fixed="CITWOT (1)"/>
							<xsd:attribute name="wersjaSchemy" type="xsd:string" use="required" fixed="1-0E"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="WariantFormularza">
				<xsd:simpleType>
					<xsd:restriction base="xsd:byte">
						<xsd:enumeration value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="OkresOd">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zcwt:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_4"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="OkresDo">
				<xsd:complexType>
					<xsd:simpleContent>
						<xsd:extension base="zcwt:TLData">
							<xsd:attribute name="poz" type="xsd:string" use="required" fixed="P_5"/>
						</xsd:extension>
					</xsd:simpleContent>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TKodFormularza_CIT_WOT">
		<xsd:annotation>
			<xsd:documentation>Symbol wzoru formularza</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CIT/WOT"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TLData">
		<xsd:annotation>
			<xsd:documentation>Ograniczenie dla daty</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="etd:TData">
			<xsd:minInclusive value="2025-01-01"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:element name="Zalacznik_CIT_WOT">
		<xsd:annotation>
			<xsd:documentation>Informacja o odliczeniach z tytułu zatrudnienia żołnierzy terytorialnej służby wojskowej lub żołnierzy aktywnej rezerwy za rok podatkowy</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="Naglowek" type="zcwt:TNaglowek_CIT_WOT"/>
				<xsd:element name="PozycjeSzczegolowe">
					<xsd:annotation>
						<xsd:documentation>Dane o żołnierzach terytorialnej służby wojskowej lub żołnierzach aktywnej rezerwy, razem przysługujące odliczenie z tytułu zatrudnienia w roku podatkowym żołnierzy terytorialnej służby wojskowej lub żołnierzy aktywnej rezerwy</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<!--A. Dane identyfikacyjne podatnika i inne informacje o podatniku-->
							<!-- -->
							<!--Podatnik będący wspólnikiem spółki niebędącej osobą prawną, która zatrudniała żołnierzy terytorialnej służby wojskowej lub żołnierzy aktywnej rezerwy, w poz. 8-11 wskazuje status tej spółki.-->
							<xsd:sequence>
								<xsd:element name="P_8" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik był w roku podatkowym mikroprzedsiębiorcą: 1 - tak</xsd:documentation>
									</xsd:annotation>
									<!--Mikroprzedsiębiorca w rozumieniu art. 7 ust. 1 pkt 1 ustawy z dnia 6 marca 2018 r. – Prawo przedsiębiorców, zwanej dalej „Prawem przedsiębiorców”.-->
								</xsd:element>
								<xsd:element name="P_9" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik był w roku podatkowym małym przedsiębiorcą: 1 - tak</xsd:documentation>
									</xsd:annotation>
									<!--Mały przedsiębiorca w rozumieniu art. 7 ust. 1 pkt 2 Prawa przedsiębiorców.-->
								</xsd:element>
								<xsd:element name="P_10" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik był w roku podatkowym przedsiębiorcą, który zatrudniał co najmniej 5 pracowników i nie był mikroprzedsiębiorcą lub małym przedsiębiorcą: 1 - tak</xsd:documentation>
									</xsd:annotation>
									<!--Przedsiębiorca, który przez cały rok podatkowy zatrudniał w ramach stosunku pracy co najmniej 5 pracowników, w przeliczeniu na pełne etaty, który nie był mikroprzedsiębiorcą lub małym przedsiębiorcą.-->
								</xsd:element>
								<xsd:element name="P_11" type="etd:TWybor1" minOccurs="0">
									<xsd:annotation>
										<xsd:documentation>Podatnik był w roku podatkowym innym przedsiębiorcą: 1 - tak</xsd:documentation>
									</xsd:annotation>
								</xsd:element>
							</xsd:sequence>
							<!--B. Dane o żołnierzach terytorialnej służby wojskowej lub żołnierzach aktywnej rezerwy-->
							<xsd:element name="P_B" maxOccurs="unbounded">
								<xsd:annotation>
									<xsd:documentation>Dane o żołnierzach terytorialnej służby wojskowej lub żołnierzach aktywnej rezerwy</xsd:documentation>
								</xsd:annotation>
								<!--Należy podać numer PESEL żołnierzy terytorialnej służby wojskowej lub żołnierzy aktywnej rezerwy, liczbę miesięcy i lat nieprzerwanej służby w terytorialnej służbie wojskowej lub w aktywnej rezerwie, okres zatrudnienia w roku podatkowym.-->
								<xsd:complexType>
									<xsd:sequence>
										<xsd:annotation>
											<xsd:documentation>Dane o żołnierzu</xsd:documentation>
										</xsd:annotation>
										<xsd:element name="P_B12" type="etd:TNrPESEL">
											<xsd:annotation>
												<xsd:documentation>PESEL</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:sequence>
											<xsd:element name="P_B13_1" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Liczba lat nieprzerwanej służby w terytorialnej służbie wojskowej lub w aktywnej rezerwie</xsd:documentation>
												</xsd:annotation>
												<!--Okres służby żołnierza terytorialnej służby wojskowej lub żołnierza aktywnej rezerwy, ustala się na dzień 31 grudnia roku podatkowego albo ostatni dzień zatrudnienia tego żołnierza w roku podatkowym.-->
												<xsd:simpleType>
													<xsd:restriction base="etd:TCalkowity">
														<xsd:maxInclusive value="99"/>
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:element>
											<xsd:element name="P_B13_2" minOccurs="0">
												<xsd:annotation>
													<xsd:documentation>Liczba miesięcy nieprzerwanej służby w terytorialnej służbie wojskowej lub w aktywnej rezerwie</xsd:documentation>
												</xsd:annotation>
												<!--Okres służby żołnierza terytorialnej służby wojskowej lub żołnierza aktywnej rezerwy, ustala się na dzień 31 grudnia roku podatkowego albo ostatni dzień zatrudnienia tego żołnierza w roku podatkowym.-->
												<xsd:simpleType>
													<xsd:restriction base="etd:TMiesiac">
														<xsd:maxInclusive value="11"/>
													</xsd:restriction>
												</xsd:simpleType>
											</xsd:element>
										</xsd:sequence>
										<xsd:element name="P_B14" type="etd:TWybor1_2">
											<xsd:annotation>
												<xsd:documentation>Okres zatrudnienia w ramach stosunku pracy żołnierza terytorialnej służby wojskowej lub aktywnej rezerwy w roku podatkowym: 1 - cały rok, 2 - niepełny rok</xsd:documentation>
											</xsd:annotation>
										</xsd:element>
										<xsd:element name="P_B15" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Liczba miesięcy kalendarzowych zatrudnienia w roku podatkowym (w przypadku zaznaczenia w poz. 14 kwadratu nr 2 należy podać liczbę pełnych miesięcy kalendarzowych zatrudnienia w ramach stosunku pracy żołnierza)</xsd:documentation>
											</xsd:annotation>
											<xsd:simpleType>
												<xsd:restriction base="etd:TMiesiac">
													<xsd:maxInclusive value="11"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
										<xsd:element name="P_B16">
											<xsd:annotation>
												<xsd:documentation>Przysługujące odliczenie z tytułu zatrudnienia w roku podatkowym żołnierza terytorialnej służby wojskowej lub żołnierza aktywnej rezerwy</xsd:documentation>
											</xsd:annotation>
											<!--W poz. 16:
- uwzględnia się zwiększenia, o których mowa w art. 18eg ust. 3 i 4 ustawy,
- nie uwzględnia się wartości nieodliczonej ulgi w poprzednich latach podlegającej odliczeniu w roku podatkowym, na podstawie art. 18eg ust. 5 ustawy.-->
											<!-- -->
											<!--Podatnik będący wspólnikiem spółki niebędącej osobą prawną wykazuje kwotę odliczenia stosownie do swojego udziału.-->
											<xsd:simpleType>
												<xsd:restriction base="etd:TKwota2Nieujemna">
													<xsd:maxInclusive value="36000"/>
												</xsd:restriction>
											</xsd:simpleType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="typ" use="required" fixed="G"/>
								</xsd:complexType>
							</xsd:element>
							<!--C. Razem przysługujące odliczenie z tytułu zatrudnienia w roku podatkowym żołnierzy terytorialnej służby wojskowej lub żołnierzy aktywnej rezerwy-->
							<xsd:element name="P_17" type="etd:TKwota2Nieujemna">
								<xsd:annotation>
									<xsd:documentation>Razem przysługujące odliczenie</xsd:documentation>
								</xsd:annotation>
								<!--Suma kwot z poz. 16 części B-->
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>